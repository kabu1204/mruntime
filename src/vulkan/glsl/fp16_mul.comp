#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer ABuffer {
    float16_t a[];
} a_buf;

layout(set = 0, binding = 1, std430) readonly buffer BBuffer {
    float16_t b[];
} b_buf;

layout(set = 0, binding = 2, std430) writeonly buffer OutBuffer {
    float16_t out_data[];
} out_buf;

layout(push_constant) uniform PushConstants {
    uint n;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) {
        return;
    }
    out_buf.out_data[i] = a_buf.a[i] * b_buf.b[i];
}

