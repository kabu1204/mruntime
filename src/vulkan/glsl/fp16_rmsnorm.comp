#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
    float16_t data[];
} input_buf;

layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer {
    float16_t data[];
} weight_buf;

layout(set = 0, binding = 2, std430) writeonly buffer OutBuffer {
    float16_t data[];
} out_buf;

layout(push_constant) uniform PushConstants {
    uint hidden_size;
    uint num_tokens;
    float eps;
} pc;

shared float shared_sum[256];

void main() {
    const uint token = gl_WorkGroupID.x;
    if (token >= pc.num_tokens) {
        return;
    }

    const uint tid = gl_LocalInvocationID.x;
    const uint row_offset = token * pc.hidden_size;

    // Each thread accumulates its stripe of the sum-of-squares.
    float partial_sum = 0.0;
    for (uint i = tid; i < pc.hidden_size; i += 256u) {
        float val = float(input_buf.data[row_offset + i]);
        partial_sum += val * val;
    }

    shared_sum[tid] = partial_sum;
    barrier();

    // Tree reduction.
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            shared_sum[tid] += shared_sum[tid + stride];
        }
        barrier();
    }

    float rms_inv = inversesqrt(shared_sum[0] / float(pc.hidden_size) + pc.eps);

    // Normalize and scale.
    for (uint i = tid; i < pc.hidden_size; i += 256u) {
        float val = float(input_buf.data[row_offset + i]);
        float w = float(weight_buf.data[i]);
        out_buf.data[row_offset + i] = float16_t(val * rms_inv * w);
    }
}
