#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(scalar, set = 0, binding = 0, std430) readonly buffer InputBuffer {
    f16vec4 data4[];
} input_buf;

layout(scalar, set = 0, binding = 1, std430) readonly buffer WeightBuffer {
    f16vec4 data4[];
} weight_buf;

layout(scalar, set = 0, binding = 2, std430) writeonly buffer OutBuffer {
    f16vec4 data4[];
} out_buf;

layout(push_constant) uniform PushConstants {
    uint hidden_size;
    uint num_tokens;
    float eps;
} pc;

shared float subgroup_sums[64];

void main() {
    const uint token = gl_WorkGroupID.x;
    if (token >= pc.num_tokens) {
        return;
    }

    const uint tid = gl_LocalInvocationID.x;
    const uint hidden4 = pc.hidden_size >> 2u;
    const uint row_offset4 = token * hidden4;

    float partial_sum = 0.0;
    for (uint i4 = tid; i4 < hidden4; i4 += gl_WorkGroupSize.x) {
        const vec4 values = vec4(input_buf.data4[row_offset4 + i4]);
        partial_sum += dot(values, values);
    }

    partial_sum = subgroupAdd(partial_sum);
    if (gl_SubgroupInvocationID == 0u) {
        subgroup_sums[gl_SubgroupID] = partial_sum;
    }
    barrier();

    if (gl_SubgroupID == 0u) {
        float subgroup_total = (tid < gl_NumSubgroups) ? subgroup_sums[tid] : 0.0;
        subgroup_total = subgroupAdd(subgroup_total);
        if (gl_SubgroupInvocationID == 0u) {
            subgroup_sums[0] = subgroup_total;
        }
    }
    barrier();

    const float rms_inv = inversesqrt(subgroup_sums[0] / float(pc.hidden_size) + pc.eps);

    for (uint i4 = tid; i4 < hidden4; i4 += gl_WorkGroupSize.x) {
        const vec4 values = vec4(input_buf.data4[row_offset4 + i4]);
        const vec4 weights = vec4(weight_buf.data4[i4]);
        out_buf.data4[row_offset4 + i4] = f16vec4(values * weights * rms_inv);
    }
}
