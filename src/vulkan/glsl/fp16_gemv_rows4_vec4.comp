#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// FP16 GEMV (vectorized, multi-row):
//   y = W @ x
//   x: [K] FP16
//   W: [N, K] row-major FP16
//   y: [N] FP16
//
// Strategy:
// - Each workgroup computes 4 output rows.
// - Use f16vec4 loads (K must be divisible by 4).
// - FP32 accumulation.
// - Reduction: subgroupAdd + shared-memory accumulation across subgroups.

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(scalar, set = 0, binding = 0, std430) readonly buffer XBuffer {
    f16vec4 x4[];
} x_buf;

layout(scalar, set = 0, binding = 1, std430) readonly buffer WBuffer {
    f16vec4 w4[];
} w_buf;

layout(scalar, set = 0, binding = 2, std430) writeonly buffer YBuffer {
    float16_t y[];
} y_buf;

layout(push_constant) uniform PushConstants {
    uint N;
    uint K;
} pc;

// [row_in_wg][subgroup_id]
shared float subgroup_sums[4][32];

vec4 to_vec4(f16vec4 v) {
    return vec4(float(v.x), float(v.y), float(v.z), float(v.w));
}

void main() {
    const uint wg = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationID.x;

    const uint row_base = wg * 4u;
    if (row_base >= pc.N) {
        return;
    }

    // K must be divisible by 4 for f16vec4 loads.
    const uint K4 = pc.K >> 2;

    const bool row0_valid = (row_base + 0u) < pc.N;
    const bool row1_valid = (row_base + 1u) < pc.N;
    const bool row2_valid = (row_base + 2u) < pc.N;
    const bool row3_valid = (row_base + 3u) < pc.N;

    const uint row0_base = (row_base + 0u) * K4;
    const uint row1_base = (row_base + 1u) * K4;
    const uint row2_base = (row_base + 2u) * K4;
    const uint row3_base = (row_base + 3u) * K4;

    float acc0 = 0.0;
    float acc1 = 0.0;
    float acc2 = 0.0;
    float acc3 = 0.0;

    const uint stride = gl_WorkGroupSize.x;

    for (uint i = tid; i < K4; i += (2u * stride)) {
        const vec4 xv0 = to_vec4(x_buf.x4[i]);

        if (row0_valid) acc0 += dot(xv0, to_vec4(w_buf.w4[row0_base + i]));
        if (row1_valid) acc1 += dot(xv0, to_vec4(w_buf.w4[row1_base + i]));
        if (row2_valid) acc2 += dot(xv0, to_vec4(w_buf.w4[row2_base + i]));
        if (row3_valid) acc3 += dot(xv0, to_vec4(w_buf.w4[row3_base + i]));

        const uint i1 = i + stride;
        if (i1 < K4) {
            const vec4 xv1 = to_vec4(x_buf.x4[i1]);

            if (row0_valid) acc0 += dot(xv1, to_vec4(w_buf.w4[row0_base + i1]));
            if (row1_valid) acc1 += dot(xv1, to_vec4(w_buf.w4[row1_base + i1]));
            if (row2_valid) acc2 += dot(xv1, to_vec4(w_buf.w4[row2_base + i1]));
            if (row3_valid) acc3 += dot(xv1, to_vec4(w_buf.w4[row3_base + i1]));
        }
    }

    acc0 = subgroupAdd(acc0);
    acc1 = subgroupAdd(acc1);
    acc2 = subgroupAdd(acc2);
    acc3 = subgroupAdd(acc3);

    if (gl_NumSubgroups == 1) {
        if (gl_SubgroupInvocationID == 0) {
            if (row0_valid) y_buf.y[row_base + 0u] = float16_t(acc0);
            if (row1_valid) y_buf.y[row_base + 1u] = float16_t(acc1);
            if (row2_valid) y_buf.y[row_base + 2u] = float16_t(acc2);
            if (row3_valid) y_buf.y[row_base + 3u] = float16_t(acc3);
        }
        return;
    }

    if (gl_SubgroupInvocationID == 0) {
        subgroup_sums[0][gl_SubgroupID] = acc0;
        subgroup_sums[1][gl_SubgroupID] = acc1;
        subgroup_sums[2][gl_SubgroupID] = acc2;
        subgroup_sums[3][gl_SubgroupID] = acc3;
    }

    barrier();

    if (tid == 0) {
        float sum0 = 0.0;
        float sum1 = 0.0;
        float sum2 = 0.0;
        float sum3 = 0.0;
        for (uint s = 0; s < gl_NumSubgroups; ++s) {
            sum0 += subgroup_sums[0][s];
            sum1 += subgroup_sums[1][s];
            sum2 += subgroup_sums[2][s];
            sum3 += subgroup_sums[3][s];
        }

        if (row0_valid) y_buf.y[row_base + 0u] = float16_t(sum0);
        if (row1_valid) y_buf.y[row_base + 1u] = float16_t(sum1);
        if (row2_valid) y_buf.y[row_base + 2u] = float16_t(sum2);
        if (row3_valid) y_buf.y[row_base + 3u] = float16_t(sum3);
    }
}

