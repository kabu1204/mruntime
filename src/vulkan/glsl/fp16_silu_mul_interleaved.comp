#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// gate_up layout: each row has [gate (intermediate_size) | up (intermediate_size)]
// i.e. gate_up[token * 2 * intermediate_size + j] = gate[j],
//      gate_up[token * 2 * intermediate_size + intermediate_size + j] = up[j]
layout(set = 0, binding = 0, std430) readonly buffer GateUpBuffer {
    float16_t gate_up[];
} gate_up_buf;

layout(set = 0, binding = 1, std430) writeonly buffer OutBuffer {
    float16_t out_data[];
} out_buf;

layout(push_constant) uniform PushConstants {
    uint intermediate_size;
    uint num_tokens;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint total = pc.num_tokens * pc.intermediate_size;
    if (i >= total) {
        return;
    }

    const uint token = i / pc.intermediate_size;
    const uint j = i % pc.intermediate_size;

    const uint row_offset = token * 2u * pc.intermediate_size;
    float gate_val = float(gate_up_buf.gate_up[row_offset + j]);
    float up_val = float(gate_up_buf.gate_up[row_offset + pc.intermediate_size + j]);

    // SiLU(gate) * up = gate * sigmoid(gate) * up
    float silu = gate_val / (1.0 + exp(-gate_val));
    out_buf.out_data[i] = float16_t(silu * up_val);
}
