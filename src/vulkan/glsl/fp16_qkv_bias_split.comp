#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer QkvBuffer {
    float16_t qkv[];
} qkv_buf;

layout(set = 0, binding = 1, std430) readonly buffer BiasBuffer {
    float16_t bias[];
} bias_buf;

layout(set = 0, binding = 2, std430) writeonly buffer QOutBuffer {
    float16_t q_out[];
} q_out_buf;

layout(set = 0, binding = 3, std430) writeonly buffer KOutBuffer {
    float16_t k_out[];
} k_out_buf;

layout(set = 0, binding = 4, std430) writeonly buffer VOutBuffer {
    float16_t v_out[];
} v_out_buf;

layout(push_constant) uniform PushConstants {
    uint num_tokens;
    uint q_dim;
    uint kv_dim;
    uint has_bias;
} pc;

void main() {
    const uint chunk_id = gl_GlobalInvocationID.x;
    const uint chunk_base = chunk_id * 8u;
    const uint qkv_dim = pc.q_dim + 2u * pc.kv_dim;
    const uint total = pc.num_tokens * qkv_dim;
    if (chunk_base >= total) {
        return;
    }

    for (uint lane = 0u; lane < 8u; ++lane) {
        const uint index = chunk_base + lane;
        if (index >= total) {
            return;
        }

        const uint token = index / qkv_dim;
        const uint elem = index % qkv_dim;
        float16_t value = qkv_buf.qkv[index];
        if (pc.has_bias != 0u) {
            value += bias_buf.bias[elem];
        }

        if (elem < pc.q_dim) {
            q_out_buf.q_out[token * pc.q_dim + elem] = value;
        } else if (elem < pc.q_dim + pc.kv_dim) {
            const uint kv_index = elem - pc.q_dim;
            k_out_buf.k_out[token * pc.kv_dim + kv_index] = value;
        } else {
            const uint kv_index = elem - pc.q_dim - pc.kv_dim;
            v_out_buf.v_out[token * pc.kv_dim + kv_index] = value;
        }
    }
}
